# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
DB_PASSWORD=
DB_ROOT_PASSWORD=
APP_JWT_SECRET=
APP_CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
BREVO_API_KEY=
APP_MAIL_FROM=
APP_MAIL_FROM_NAME=SoulSync
# Razorpay — Dashboard → Account & Settings → API Keys (rzp_test_… for test mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks (events: payment.captured, order.paid) → URL /api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=
